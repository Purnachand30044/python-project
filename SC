

import json
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from datetime import datetime

# ================= FILE HANDLING =================

def load_data(file):
    try:
        with open(file, "r") as f:
            return json.load(f)
    except:
        return []

def save_data(file, data):
    with open(file, "w") as f:
        json.dump(data, f, indent=4)

# ================= CLASSES =================

class Facility:
    def __init__(self, fid, building, room_type, capacity, floor, coordinates):
        self.id = fid
        self.building = building
        self.room_type = room_type
        self.capacity = capacity
        self.floor = floor
        self.coordinates = coordinates

    def to_dict(self):
        return self.__dict__

class Booking:
    def __init__(self, bid, fid, purpose, start, end):
        self.booking_id = bid
        self.facility_id = fid
        self.purpose = purpose
        self.start_time = start
        self.end_time = end

    def to_dict(self):
        return self.__dict__

class Complaint:
    def __init__(self, cid, fid, issue, severity):
        self.complaint_id = cid
        self.facility_id = fid
        self.issue = issue
        self.severity = severity
        self.status = "Open"
        self.timestamp = str(datetime.now())

    def to_dict(self):
        return self.__dict__

class Asset:
    def __init__(self, aid, category, building, room, status):
        self.asset_id = aid
        self.category = category
        self.building = building
        self.room = room
        self.status = status

    def to_dict(self):
        return self.__dict__

# ================= DATA =================

facilities = load_data("facilities.json")
bookings = load_data("bookings.json")
complaints = load_data("complaints.json")
assets = load_data("assets.json")

# ================= MODULE 1 =================

def add_facility():
    fid = input("Enter Facility ID: ")
    building = input("Building: ")

    print("Room Type: 1. Lab  2. Classroom")
    ch = input("Choice: ")
    room_type = "Lab" if ch == "1" else "Classroom"

    capacity = int(input("Capacity: "))
    floor = int(input("Floor: "))
    x = int(input("X: "))
    y = int(input("Y: "))

    f = Facility(fid, building, room_type, capacity, floor, (x, y))
    facilities.append(f.to_dict())

    save_data("facilities.json", facilities)
    print("✅ Facility Added")

def display_facilities():
    for f in facilities:
        print(f)

def find_nearest():
    x = int(input("Enter your X: "))
    y = int(input("Enter your Y: "))

    nearest = None
    min_dist = float('inf')

    for f in facilities:
        fx, fy = f["coordinates"]
        dist = np.sqrt((fx-x)**2 + (fy-y)**2)

        if dist < min_dist:
            min_dist = dist
            nearest = f

    print("Nearest Facility:", nearest)

# ================= MODULE 2 =================

def book_facility():
    try:
        bid = input("Enter Booking ID: ")
        fid = input("Facility ID: ")
        start = input("Start time: ")
        end = input("End time: ")

        for b in bookings:
            if b["facility_id"] == fid and b["start_time"] == start:
                raise Exception("Booking Conflict!")

        purpose = input("Purpose: ")

        booking = Booking(bid, fid, purpose, start, end)
        bookings.append(booking.to_dict())

        save_data("bookings.json", bookings)
        print("✅ Booking Confirmed")

    except Exception as e:
        print("❌ Error:", e)

# ================= MODULE 3 =================

def raise_complaint():
    cid = input("Complaint ID: ")
    fid = input("Facility ID: ")
    issue = input("Issue: ")
    severity = int(input("Severity (1-5): "))

    c = Complaint(cid, fid, issue, severity)
    complaints.append(c.to_dict())

    save_data("complaints.json", complaints)
    print("✅ Complaint Registered")

# ================= MODULE 4 =================

def add_asset():
    aid = input("Asset ID: ")
    category = input("Category: ")
    building = input("Building: ")
    room = input("Room: ")
    status = input("Status: ")

    a = Asset(aid, category, building, room, status)
    assets.append(a.to_dict())

    save_data("assets.json", assets)
    print("✅ Asset Added")

# ================= MODULE 5 =================

def analytics():
    print("\n--- Booking Analysis ---")
    if bookings:
        df = pd.DataFrame(bookings)
        print(df["facility_id"].value_counts())

    print("\n--- Complaint Analysis ---")
    if complaints:
        df = pd.DataFrame(complaints)
        print(df["facility_id"].value_counts())

    print("\n--- Asset Analysis ---")
    if assets:
        df = pd.DataFrame(assets)
        print(df["category"].value_counts())

# ================= MODULE 6 (GRAPHS) =================

def plot_graphs():
    if bookings:
        df = pd.DataFrame(bookings)
        df["facility_id"].value_counts().plot(kind="bar")
        plt.title("Facility Usage")
        plt.show()

    if complaints:
        df = pd.DataFrame(complaints)
        df["facility_id"].value_counts().plot(kind="bar")
        plt.title("Complaint Analysis")
        plt.show()

# ================= MENU =================

while True:
    print("\n===== SMART CAMPUS SYSTEM =====")
    print("1. Add Facility")
    print("2. View Facilities")
    print("3. Find Nearest")
    print("4. Book Facility")
    print("5. Raise Complaint")
    print("6. Add Asset")
    print("7. Analytics")
    print("8. Show Graphs")
    print("9. Exit")

    ch = input("Enter choice: ")

    if ch == "1": add_facility()
    elif ch == "2": display_facilities()
    elif ch == "3": find_nearest()
    elif ch == "4": book_facility()
    elif ch == "5": raise_complaint()
    elif ch == "6": add_asset()
    elif ch == "7": analytics()
    elif ch == "8": plot_graphs()
    elif ch == "9": break
    else:
        print("Invalid choice")